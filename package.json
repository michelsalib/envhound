{
  "name": "envhound",
  "version": "0.2.0",
  "description": "Find which startup file sets each environment variable, and audit your PATH",
  "keywords": [
    "environment",
    "env",
    "path",
    "bashrc",
    "profile",
    "dotfiles",
    "shell"
  ],
  "license": "MIT",
  "author": "Michel Salib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michelsalib/envhound.git"
  },
  "homepage": "https://github.com/michelsalib/envhound#readme",
  "bugs": "https://github.com/michelsalib/envhound/issues",
  "type": "module",
  "bin": {
    "envhound": "dist/envhound.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=node --minify --outfile dist/envhound.js",
    "test": "bun test",
    "typecheck": "tsc",
    "prepublishOnly": "bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
