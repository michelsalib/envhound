{
	"name": "@michelsalib/envhound",
	"version": "0.7.1",
	"description": "Find which startup file sets each environment variable, and audit your PATH",
	"keywords": [
		"environment",
		"env",
		"path",
		"bashrc",
		"profile",
		"dotfiles",
		"shell"
	],
	"license": "MIT",
	"author": "Michel Salib",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/michelsalib/envhound.git"
	},
	"homepage": "https://github.com/michelsalib/envhound#readme",
	"bugs": "https://github.com/michelsalib/envhound/issues",
	"type": "module",
	"bin": {
		"envhound": "dist/envhound.js"
	},
	"files": [
		"dist/envhound.js",
		"dist/SHA256SUMS"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "bun src/cli.ts",
		"build": "bun build src/cli.ts --target=node --minify --outfile dist/envhound.js",
		"build:bin": "bun scripts/build-binaries.ts",
		"test": "bun test --timeout 30000",
		"typecheck": "tsc",
		"lint": "biome check",
		"prepublishOnly": "bun run typecheck && bun run lint && bun run build && bun test --timeout 30000"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"fast-check": "4.10.2",
		"typescript": "^7.0.2"
	}
}
