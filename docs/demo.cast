[49.166,"o","\u001b[H\u001b[1menvhound edit\u001b[0m  \u001b[2m 1 Variables \u001b[0m \u001b[7m 2 PATH \u001b[0m   \u001b[33m2 staged · w to write\u001b[0m\u001b[K\r\r\n\u001b[2m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[K\r\r\n\u001b[1m   #  DIRECTORY        ADDED BY             \u001b[0m\u001b[K\r\r\n\u001b[7m+  1  ~/bin            envhound               staged: add                                                              \u001b[0m\u001b[K\r\r\n   2  ~/.cargo/bin     ~/.zshrc:4 add_path()                                                                           \u001b[K\r\r\n   3  ~/.pyenv/shims   ~/.zshrc:3                                                                                      \u001b[K\r\r\n   4  ~/.local/bin     ~/.zprofile:2                                                                                   \u001b[K\r\r\n\u001b[2m   5  /usr/local/sbin  (initial)                                                                                       \u001b[0m\u001b[K\r\r\n\u001b[2m   6  /usr/local/bin   (initial)                                                                                       \u001b[0m\u001b[K\r\r\n\u001b[2m   7  /usr/sbin        (initial)                                                                                       \u001b[0m\u001b[K\r\r\n\u001b[2m   8  /usr/bin         (initial)                                                                                       \u001b[0m\u001b[K\r\r\n\u001b[2m   9  /sbin            (initial)                                                                                       \u001b[0m\u001b[K\r\r\n\u001b[2m  10  /bin             (initial)                                                                                       \u001b[0m\u001b[K\r\r\n  11  ~/go/bin         ~/.zprofile:4                                                                                   \u001b[K\r\r\n\u001b[K\r\r\n\