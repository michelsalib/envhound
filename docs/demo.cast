[12.538,"o","\u001b[1mpython3\u001b[0m runs ~/.pyenv/shims/python3\r\n  from PATH #2 ~/.pyenv/shims, added at ~/.zshrc:3\r\n\r\nAlso in PATH, but hidden by it:\r\n  ~/.local/bin/python3\r\n    \u001b[2mPATH #3 ~/.local/bin, added at ~/.zprofile:2\u001b[0m\r\n  /usr/bin/python3\u001b[2m → /usr/bin/python3.12\u001b[0m\r\n    \u001b[2mPATH #7 /usr/bin, in the PATH the shell started with\u001b[0m\r\n  /bin/python3\u001b[2m → /usr/bin/python3.12\u001b[0m\u001b[2m (the same file as PATH #7)\u001b[0m\r\n    \u001b[2mPATH #9 /bin, in the PATH the shell started with\u001b[0m\r\n\r\n\u001b[2mAliases, functions and builtins come before PATH: type python3 shows them.\u001b[0m\r\n"]
