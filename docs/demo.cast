[31.826,"o","\u001b[1m~/.config/envhound/env.sh (new file)\u001b[0m\r\n"]
[31.866,"o","\u001b[32m+ # Managed by envhound: environment variables for your login shell.\u001b[0m\r\n"]
[31.906,"o","\u001b[32m+ # Change them with `envhound set NAME=value`, `envhound unset NAME` and `envhound path add DIR`.\u001b[0m\r\n"]
[31.946,"o","\u001b[32m+ # Hand edits are fine: envhound keeps lines it does not recognise.\u001b[0m\r\n"]
[31.986,"o","\u001b[32m+ export EDITOR=code\u001b[0m\r\n"]
