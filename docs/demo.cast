[51.18,"o","\u001b[1m~/.config/envhound/env.sh (new file)\u001b[0m\r\n\u001b[32m+ # Managed by envhound: environment variables for your login shell.\u001b[0m\r\n\u001b[32m+ # Change them with `envhound set NAME=value`, `envhound unset NAME` and `envhound path add DIR`.\u001b[0m\r\n\u001b[32m+ # Hand edits are fine: envhound keeps lines it does not recognise.\u001b[0m\r\n\u001b[32m+ export VISUAL='code --wait'\u001b[0m\r\n\u001b[32m+ case \":$PATH:\" in *\":$HOME/bin:\"*) ;; *) export PATH=\"$HOME/bin:$PATH\" ;; esac\u001b[0m\r\n\r\n\u001b[1m~/.zprofile\u001b[0m\r\n\u001b[2m  export GOPATH=$HOME/go\u001b[0m\r\n\u001b[2m  path+=($GOPATH/bin)\u001b[0m\r\n\u001b[32m+ \u001b[0m\r\n\u001b[32m+ # Added by envhound: load variables managed with `envhound set`\u001b[0m\r\n\u001b[32m+ [ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/envhound/env.sh\" ] && . \"${XDG_CONFIG_HOME:-$HOME/.config}/envhound/env.sh\"\u001b[0m\r\n\r\n"]
[51.181,"o","\u001b[1G\u001b[0J"]
[51.182,"o","Write these changes? [y/N] \u001b[28G"]
[53.687,"o","y"]
[53.987,"o","\r\r\n"]
[53.993,"o","wrote ~/.config/envhound/env.sh\r\n"]
[53.994,"o","wrote ~/.zprofile\r\n"]
