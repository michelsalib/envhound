[54.007,"o","\u001b[32m✓ a fresh login shell now gets VISUAL\u001b[0m\r\n\u001b[32m✓ ~/bin is now in PATH for a fresh login shell\u001b[0m\r\n"]
[54.007,"o","\u001b[2m\r\nThis shell is unchanged. To apply it here too, run:\r\n\u001b[0m  export VISUAL='code --wait'\r\n  export PATH=\"$HOME/bin:$PATH\"\r\n"]
[54.007,"o","\u001b[1;32m$\u001b[0m "]
